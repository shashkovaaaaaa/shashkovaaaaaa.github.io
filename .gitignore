# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# next-image-export-optimizer (генерируется при сборке)
# варианты кладутся рядом с исходником на любой глубине: public/images/**/nextImageExportOptimizer/
/public/**/nextImageExportOptimizer/
next-image-export-optimizer-hashes.json
/remoteOptimizedImagesCache/

# исходный архив макета
*.zip

# служебные файлы — только локально, в публичный репозиторий не попадают:
# макет в текстовом виде и исходники картинок, контекст для агента, вопросы к дизайнеру
/design/
/CLAUDE.md
/.claude/
/DESIGN-QUESTIONS.md

# playwright
/e2e/.results/
/playwright-report/
